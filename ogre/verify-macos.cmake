# Inspect generated effective settings, not requested cache values.
file(READ "${OGRE_BINARY_DIR}/include/OgreBuildSettings.h" settings)
foreach(feature RENDERSYSTEM_GL3PLUS PLUGIN_STBI COMPONENT_OVERLAY COMPONENT_PAGING
        COMPONENT_RTSHADERSYSTEM COMPONENT_MESHLODGENERATOR COMPONENT_TERRAIN)
    if(NOT settings MATCHES "#define OGRE_BUILD_${feature}[\r\n]")
        message(FATAL_ERROR "Required effective OGRE feature is missing: ${feature}")
    endif()
endforeach()
foreach(feature RENDERSYSTEM_GL PLUGIN_CG PLUGIN_FREEIMAGE)
    if(settings MATCHES "#define OGRE_BUILD_${feature}[\r\n]")
        message(FATAL_ERROR "Unexpected effective OGRE feature: ${feature}")
    endif()
endforeach()
foreach(setting "OGRE_NO_ZIP_ARCHIVE 0" "OGRE_BITES_HAVE_SDL 0" "OGRE_RESOURCEMANAGER_STRICT 0")
    if(NOT settings MATCHES "#define ${setting}[\r\n]")
        message(FATAL_ERROR "Unexpected effective OGRE setting: ${setting}")
    endif()
endforeach()
file(READ "${OGRE_BINARY_DIR}/CMakeFiles/TargetDirectories.txt" targets)
if(NOT targets MATCHES "/OgreBites.dir[\r\n]")
    message(FATAL_ERROR "Required OgreBites target was not generated")
endif()
message(STATUS "Effective macOS OGRE GL3/STBI/ZIP/component profile verified")
